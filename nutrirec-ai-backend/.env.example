# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke repository.

# ──────────────────────────────────────────
# Koneksi MySQL
# ──────────────────────────────────────────
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://nutrirec_user:ganti_password_anda@localhost:3306/nutrirec_db

# ──────────────────────────────────────────
# Aplikasi
# ──────────────────────────────────────────
APP_ENV=development
# development | production

DEBUG=true

# ──────────────────────────────────────────
# CORS (pisahkan dengan koma jika lebih dari satu)
# ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ──────────────────────────────────────────
# Versi dataset — dipakai untuk menandai data yang diimpor
# ──────────────────────────────────────────
DATASET_VERSION=revisi-PD11-R1

